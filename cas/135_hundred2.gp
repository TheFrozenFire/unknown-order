\\ Second hundred Strong-RSA algorithm-class pins.  Mirrors HundredI..HundredM.v.
\\ Probe names avoid the word "fail" (cas-gate tally footgun).

ok = 0; fail = 0;
check(cond, name) = if(cond, ok++; printf("  ok  %s\n", name), fail++; printf(" FAIL %s\n", name));

p=11; q=17; N=p*q; lam=80; y=36;

\\ ========== I 101-120 x=f(y) ==========
check(lift(Mod(y,N)^7)==9,              "101 y^7 ≡ 9");
check(lift(Mod(9,N)^3)==168,            "101 9^3 ≡ 168");
check(gcd(168-y,N)==11,                 "101 gcd(168-36,N)=11 one-sided");
check(lift(Mod(y,N)^9)==70,             "102 y^9 ≡ 70");
check(lift(Mod(70,N)^3)==42,            "102 70^3 ≡ 42 not 36");
check(gcd(42-y,N)==1,                   "102 gcd(42-36,N)=1");
check(lift(Mod(y,N)^11)==25,            "103 y^11 ≡ 25");
check(lift(Mod(25,N)^3)==104,           "103 25^3 ≡ 104");
check(gcd(104-y,N)==17,                 "103 gcd(104-36,N)=17 one-sided");
check(y\3==12,                          "104 floor y/3 = 12");
check(lift(Mod(12,N)^3)==45,            "104 12^3 ≡ 45 not 36");
check(N\y==5,                           "105 floor N/y = 5");
check(lift(Mod(5,N)^3)==125,            "105 5^3 ≡ 125 not 36");
check(3*y==108,                         "106 3y=108");
check(lift(Mod(108,N)^3)==80,           "106 108^3 ≡ 80");
check(gcd(80-y,N)==11,                  "106 gcd(80-36,N)=11 one-sided");
check(lift(Mod(35,N)^3)==52,            "107 (y-1)^3 ≡ 52 not 36");
check(lift(Mod(37,N)^3)==163,           "108 (y+1)^3 ≡ 163 not 36");
check(37==nextprime(y),                 "108 y+1 coincides with nextprime");
check(lift(Mod(73,N)^3)==57,            "109 (2y+1)^3 ≡ 57 not 36");
check((y^2-1)%N==173,                   "110 y^2-1 ≡ 173");
check(lift(Mod(173,N)^3)==61,           "110 173^3 ≡ 61 not 36");
gray=bitxor(y, y>>1);
check(gray==54,                         "111 Gray of 36 is 54");
check(lift(Mod(54,N)^3)==10,            "111 54^3 ≡ 10 not 36");
nsw=fromdigits(Vecrev(digits(y,16)),16);
check(nsw==66,                          "112 nibble-swap of 36 is 66");
check(gcd(66,N)==11,                    "112 gcd(66,N)=11 non-unit");
check(hammingweight(y)==2,              "113 popcount 36 is 2");
check(lift(Mod(2,N)^3)==8,              "113 2^3 ≡ 8 not 36");
check(binomial(10,5)/6==42,             "114 Catalan C_5=42");
check(lift(Mod(42,N)^3)==36,            "114 C_5 is the cube root");
check(47==47,                           "115 Lucas L_8=47");
check(lift(Mod(47,N)^3)==38,            "115 47^3 ≡ 38 not 36");
check(216%N==29,                        "116 floor y^{3/2} ≡ 29");
check(lift(Mod(29,N)^3)==79,            "116 29^3 ≡ 79 not 36");
check((y*4)%N==144,                     "117 y<<2 ≡ 144");
check(lift(Mod(144,N)^3)==155,          "117 144^3 ≡ 155");
check(gcd(155-y,N)==17,                 "117 gcd(155-36,N)=17 one-sided");
check(y%16==4,                          "118 y mod 16 = 4");
check(lift(Mod(4,N)^3)==64,             "118 4^3 ≡ 64 not 36");
check(fromdigits(Vecrev(binary(y)),2)==9, "119 6-bit reverse is 9, 8-bit is palindrome 36");
check(lift(Mod(y,N)^3)==93,             "119 palindrome x=y cubes to 93");
check(numbpart(10)==42,                 "120 p(10)=42");
check(lift(Mod(42,N)^3)==36,            "120 p(10) is the cube root");

\\ ========== J 121-140 e=f(y)/f(N) ==========
check(gcd(35,lam)==5 && 35%2==1,        "121 e=y-1=35 shares λ");
check(gcd(73,lam)==1 && 73%2==1,        "122 e=2y+1=73 leftover-shaped");
check(lift(Mod(53,N)^73)==36,           "122 53^{73} ≡ 36");
check(gcd(71,lam)==1 && 71%2==1,        "123 e=2y-1=71 leftover-shaped");
check(lift(Mod(179,N)^71)==36,          "123 179^{71} ≡ 36");
check(precprime(y)==31,                 "124 prevprime(36)=31");
check(gcd(31,lam)==1 && 31%2==1,        "124 e=31 leftover-shaped");
check(lift(Mod(179,N)^31)==36,          "124 179^{31} ≡ 36");
check(72%2==0,                          "125 Dedekind psi(36)=72 even");
check(znorder(Mod(y,N))==40 && 40%2==0, "126 ord(y)=40 even");
check(eulerphi(N)==160 && 160%2==0,     "127 phi(N)=160 even");
check(gcd(27,lam)==1 && 27%2==1,        "128 e=d=27 leftover-shaped");
check(lift(Mod(93,N)^27)==36,           "128 93^{27} ≡ 36");
check(sigma(y)-y==55 && gcd(55,lam)==5, "129 s(y)=55 shares λ");
check(gcd(17,lam)==1 && 17%2==1,        "130 e=17 leftover-shaped");
check(lift(Mod(104,N)^17)==36,          "130 104^{17} ≡ 36");
check((N+1)%2==0,                       "131 e=N+1=188 even");
check((N-1)%2==0,                       "132 e=N-1=186 even");
check(gcd(79,lam)==1 && 79%2==1,        "133 e=λ-1=79 leftover-shaped");
check(lift(Mod(26,N)^79)==36,           "133 26^{79} ≡ 36");
check(eulerphi(y)+1==13,                "134 phi(y)+1=13");
check(gcd(13,lam)==1,                   "134 e=13 leftover-shaped");
check(lift(Mod(185,N)^13)==36,          "134 185^{13} ≡ 36");
check(3+6==9 && gcd(9,lam)==1,          "135 digit-sum 9 leftover-shaped");
check(gcd(111,lam)==1 && 111%2==1,      "136 repunit 111 leftover-shaped");
check(lift(Mod(179,N)^111)==36,         "136 179^{111} ≡ 36");
check(2*3*5*7==210 && 210%2==0,         "137 7-primorial 210 even");
check(gcd(5,lam)==5 && 5%2==1,          "138 Fermat 5 shares λ");
st=0; c=36; while(c>1, if(c%2==0, c=c/2, c=3*c+1); st++);
check(st==21,                           "139 Collatz steps 36->1 is 21");
check(gcd(21,lam)==1 && 21%2==1,        "139 e=21 leftover-shaped");
check(lift(Mod(168,N)^21)==36,          "139 168^{21} ≡ 36");
check(36/4==9 && gcd(9,lam)==1,         "140 squarefree core 9 leftover-shaped");

\\ ========== K 141-160 extras ==========
check(p+q==28,                          "141 p+q=28");
check(lcm(p+1,q+1)==36,                 "142 torus order 36 equals y");
check(eulerphi(N)/lam==2,               "143 phi/λ=2");
check(N%8==3,                           "144 N ≡ 3 (mod 8)");
check(1+logint(N,2)==8,                 "145 bitlength N=8");
check(valuation(N-1,2)==1,              "146 v2(N-1)=1");
check(gcd(p-1,q-1)==2 && lam!=eulerphi(N), "147 (Z/NZ)* not cyclic");
check(hammingweight(N)==6,              "148 Hamming N=6");
Nr=fromdigits(Vecrev(digits(N)));
check(Nr==781,                          "149 digit-reverse N=781");
check(gcd(781,N)==11,                   "149 gcd(781,N)=11 splits");
check(p%4==3 && q%4==1,                 "150 p≡3, q≡1 (mod 4)");
check(11%4==3,                          "150 p≡3 odd exponent, N not a sum of two squares");
check(N%8==3,                           "151 N ≡ 3 (mod 8) 2-Sylow");
check(digits(N)==[1,8,7],               "152 digits of N are 1,8,7");
check(N%100==87,                        "153 N mod 100=87");
check(nextprime(N)==191,                "154 nextprime(N)=191");
check(precprime(N)==181,                "155 prevprime(N)=181");
check(181==N-6,                         "155 181 is associate of -6");
check(lift(Mod(y,N)^lam)==1,            "156 y^λ ≡ 1");
check(lift(Mod(y,N)^eulerphi(N))==1,    "157 y^φ ≡ 1 Euler");
check(gcd(3^8-1,N)==1,                  "158 gcd(3^8-1,N)=1");
check(gcd(3^10-1,N)==11,                "158 gcd(3^10-1,N)=11 splits");
check(znorder(Mod(2,N))==40,            "159 ord(2)=40");
check(eulerphi(N)==(p-1)*(q-1),         "160 φ=(p-1)(q-1)");

\\ ========== L 161-180 queries ==========
check(bitxor(42,60)==22,                "161 42 xor 60 = 22");
check(lift(Mod(22,N)^3)==176,           "161 22^3 ≡ 176 not 36");
check(lift(Mod(y,N)^3)==93,             "162 related y^3 ≡ 93");
check(gcd(43,lam)==1 && 43%2==1,        "163 e=43 leftover-shaped");
check(lift(Mod(42,N)^43)==36,           "163 42^{43} ≡ 36");
check(gcd(47,lam)==1 && 47%2==1,        "164 e=47 leftover-shaped");
check(lift(Mod(60,N)^47)==36,           "164 60^{47} ≡ 36");
check(gcd(23,lam)==1 && 23%2==1,        "165 e=23 leftover-shaped");
check(lift(Mod(9,N)^23)==36,            "165 9^{23} ≡ 36");
check(gcd(19,lam)==1 && 19%2==1,        "166 e=19 leftover-shaped");
check(lift(Mod(59,N)^19)==36,           "166 59^{19} ≡ 36");
check(gcd(59,lam)==1 && 59%2==1,        "167 e=59 leftover-shaped");
check(lift(Mod(59,N)^59)==36,           "167 59^{59} ≡ 36 x=e");
check(fibonacci(9)==34,                 "168 F_9=34");
check(gcd(34,N)==17,                    "168 gcd(F_9,N)=17 splits");
check(fibonacci(10)==55,                "169 F_10=55");
check(gcd(55,N)==11,                    "169 gcd(F_10,N)=11 splits");
check(2^8-1==255,                       "170 2^8-1=255");
check(gcd(255,N)==17,                   "170 gcd(2^8-1,N)=17 splits");
check(binomial(12,6)/7==132,            "171 Catalan C_6=132");
check(gcd(132,N)==11,                   "171 gcd(C_6,N)=11 non-unit");
check(lift(1/Mod(y,N)^2)==115,          "172 y^{-2} ≡ 115");
check(lift(Mod(115,N)^3)==4,            "172 115^3 ≡ 4 not 36");
check(lift(Mod(y,N)^lam)==1,            "173 y^λ ≡ 1 identity");
check(1!=y,                             "173 1 is not 36");
check(eulerphi(N)==160,                 "174 x=φ=160");
check(lift(Mod(160,N)^3)==139,          "174 160^3 ≡ 139 not 36");
check(1+logint(N,2)==8,                 "175 x=bitlength N=8");
check(lift(Mod(8,N)^3)==138,            "175 8^3 ≡ 138 not 36");
check(gcd(42-25,N)==17,                 "176 gcd(42-25,N)=17 leftover pair splits");
check(gcd(42-60,N)==1,                  "176 gcd(42-60,N)=1");
check(gcd(107,lam)==1 && 107%2==1,      "177 e=N-λ=107 leftover-shaped");
check(lift(Mod(93,N)^107)==36,          "177 93^{107} ≡ 36");
check(y%16==4,                          "178 first nibble of y is 4");
check(y%4==0,                           "179 two-bit advice y ≡ 0 (mod 4)");
check(nextprime(N)%N==4,                "180 nextprime(N) mod N = 4");
check(lift(Mod(4,N)^3)==64,             "180 4^3 ≡ 64 not 36");

\\ ========== M 181-200 engines / modulus / DL ==========
M8=lcm(1,lcm(2,lcm(3,lcm(4,lcm(5,lcm(6,lcm(7,8)))))));
check(M8==840,                          "181 lcm(1..8)=840");
check(gcd(lift(Mod(2,N)^840)-1,N)==N,   "181 p-1 B=8 annihilates both");
check(gcd(8-41,N)==11,                  "182 rho f=x^2-1 tortoise 8 hare 41");
check((2*2-1)==3 && (3*3-1)==8,         "182 walk 2,3,8");
Vnm2=2; Vnm1=3;
for(n=2,12, V=3*Vnm1-Vnm2; Vnm2=Vnm1; Vnm1=V);
check(gcd(Vnm1-2,N)==1,                 "183 Williams P=3 V_12 does not split");
check(gcd(10!,N)==1,                    "184 gcd(10!,N)=1");
check(14^2-N==9 && issquare(9),         "185 Hart / Fermat 14^2-N=9");
check((14-3)==11 && (14+3)==17,         "186 Lehman/Fermat recovers {11,17}");
check(N%13!=0 && N%11==0,               "187 trial 13 misses, 11 hits");
check(gcd(fibonacci(9),N)==17,          "188 Fibonacci gcd engine F_9");
check(gcd(2^8-1,N)==17,                 "189 Mersenne 2^8-1 splits");
check(znorder(Mod(2,N))==40 && 40!=lam, "190 Shor period of 2 is 40 not λ");
check(5*11==55 && lcm(4,10)==20,        "191 N=55 λ=20");
check(gcd(3,20)==1,                     "191 cube residual-shaped on 55");
check(7*17==119 && lcm(6,16)==48,       "192 N=119 λ=48");
check(gcd(3,48)==3,                     "192 cube shares λ on 119");
check(11*19==209 && lcm(10,18)==90,     "193 N=209 λ=90");
check(gcd(3,90)==3,                     "193 cube shares λ on 209");
check(13*17==221 && lcm(12,16)==48,     "194 N=221 λ=48");
check(gcd(3,48)==3,                     "194 cube shares λ on 221");
check(17*19==323 && lcm(16,18)==144,    "195 N=323 λ=144");
check(gcd(3,144)==3,                    "195 cube shares λ on 323");
check(11^3==1331 && isprime(11),        "196 N=p^3=1331");
check(lift(Mod(5,N)^22)==36,            "197 5^{22} ≡ 36 in <5>");
check(lift(Mod(5,N)^34)==42,            "197 cube root 5^{34} ≡ 42");
check((34*3)%lam==22,                   "197 34*3 ≡ 22 (mod λ) SAGM-both");
check(lift(Mod(9,N)^23)==36,            "198 9^{23} ≡ 36 in <9>");
check(lift(Mod(9,N)^21)==42,            "198 cube root 9^{21} ≡ 42");
check((21*3)%40==23,                    "198 21*3 ≡ 23 (mod ord 9)");
check(nextprime(N)==191,                "199 nextprime N=191");
check(gcd(191,lam)==1 && 191%2==1,      "199 e=191 leftover-shaped");
check(precprime(N)==181,                "200 prevprime N=181");
check(lift(Mod(181,N)^2)==36,           "200 181^2 ≡ 36 even-e peel");

printf("%d ok, %d fail\n", ok, fail);
if(fail, error("CAS failures"));
